# Copy to `.env` (or `.env.local`) to change how the frontend reaches FastAPI.
# Both are optional — the defaults work for `uvicorn app.main:app` on port 8000.

# Where the dev-server proxy forwards `/api/*`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Base URL the axios instance calls. Leave unset to use `/api` (the proxy above).
# Set it to an absolute URL for a deployed build — the backend must then allow
# this origin in CORS (`FRONTEND_URL` in backend/.env).
# VITE_API_BASE_URL=https://api.example.com
