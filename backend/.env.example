# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL=postgresql+psycopg://postgres:CHANGEME@localhost:5432/devgraph

JWT_SECRET_KEY=CHANGEME-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

GROQ_API_KEY=CHANGEME
MODEL_NAME=openai/gpt-oss-120b

FRONTEND_URL=http://localhost:5173

# "debug" turns on SQLAlchemy echo
MODE=development

# Neo4j: `docker compose up -d neo4j` matches these defaults.
# For Neo4j Aura use neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devgraph123
NEO4J_DATABASE=neo4j

MAX_ZIP_SIZE_MB=50
MAX_REPO_FILES=2000
